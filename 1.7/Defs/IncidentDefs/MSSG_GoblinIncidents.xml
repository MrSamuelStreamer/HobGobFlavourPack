<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- E1 Pit Overflow. Needs a player-owned goblin spawning hole. baseChance is a first guess. -->
  <IncidentDef>
    <defName>MSSG_PitOverflow</defName>
    <label>pit overflow</label>
    <category>Misc</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>HobGob.Events.IncidentWorker_PitOverflow</workerClass>
    <baseChance>0.5</baseChance>
    <minRefireDays>15</minRefireDays>
    <letterLabel>Pit overflow</letterLabel>
    <letterText>The pit has overflowed! {COUNT} noblins have crawled out, and they're hungry.\n\nFeed them soon. A starving noblin fresh from the pit is a miserable noblin.</letterText>
    <letterDef>PositiveEvent</letterDef>
  </IncidentDef>
</Defs>
