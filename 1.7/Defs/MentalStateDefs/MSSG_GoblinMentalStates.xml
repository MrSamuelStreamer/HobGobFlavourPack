<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- E5 Noblin Stampede. Only started by the incident; no MentalBreakDef, so it never happens as a mood break. -->
  <MentalStateDef ParentName="BaseMentalState">
    <defName>MSSG_NoblinStampede</defName>
    <label>stampeding</label>
    <stateClass>HobGob.Events.MentalState_NoblinStampede</stateClass>
    <category>Misc</category>
    <minTicksBeforeRecovery>5000</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>10000</maxTicksBeforeRecovery>
    <recoveryMtbDays>0.1</recoveryMtbDays>
    <nameColor>(0.95, 0.75, 0.4)</nameColor>
    <recoveryMessage>{0} has stopped stampeding.</recoveryMessage>
    <baseInspectLine>Mental state: Stampeding</baseInspectLine>
  </MentalStateDef>

  <!-- E2 duel: HobGob.Events.MentalState_GoblinDuel never recovers on its own and does not end the partner's state.
       HobGob.Events.HobgoblinChallengeComponent ends it: someone drops, or the duel times out (a draw).
       Category Aggro: vanilla then skips the faction goodwill penalty for damage between the two fighters. -->
  <MentalStateDef ParentName="BaseMentalState">
    <defName>MSSG_GoblinDuel</defName>
    <label>dueling</label>
    <stateClass>HobGob.Events.MentalState_GoblinDuel</stateClass>
    <category>Aggro</category>
    <minTicksBeforeRecovery>999999999</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>999999999</maxTicksBeforeRecovery>
    <recoveryMtbDays>999999</recoveryMtbDays>
    <nameColor>(0.88, 0.48, 0.16)</nameColor>
    <baseInspectLine>Mental state: Dueling</baseInspectLine>
    <inCaravanCanDo>false</inCaravanCanDo>
  </MentalStateDef>

 
  <MentalStateDef ParentName="BaseMentalState">
    <defName>MSSG_GoblinDeathDuel</defName>
    <label>dueling to the death</label>
    <stateClass>HobGob.Events.MentalState_GoblinDeathDuel</stateClass>
    <category>Aggro</category>
    <minTicksBeforeRecovery>999999999</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>999999999</maxTicksBeforeRecovery>
    <recoveryMtbDays>999999</recoveryMtbDays>
    <recoverFromDowned>false</recoverFromDowned>
    <nameColor>(0.88, 0.2, 0.16)</nameColor>
    <baseInspectLine>Mental state: Dueling to the death</baseInspectLine>
    <inCaravanCanDo>false</inCaravanCanDo>
  </MentalStateDef>

  <!-- Nobby Nobby Rumble: every noblin for itself. Started and ended only by HobGob.Rumble.NobbyRumbleComponent.
       Never self-recovers; recoverFromDowned off so a fighter who gets back up keeps fighting. -->
  <MentalStateDef ParentName="BaseMentalState">
    <defName>MSSG_NobbyRumble</defName>
    <label>rumbling</label>
    <stateClass>HobGob.Rumble.MentalState_NobbyRumble</stateClass>
    <category>Aggro</category>
    <minTicksBeforeRecovery>999999999</minTicksBeforeRecovery>
    <maxTicksBeforeRecovery>999999999</maxTicksBeforeRecovery>
    <recoveryMtbDays>999999</recoveryMtbDays>
    <recoverFromDowned>false</recoverFromDowned>
    <nameColor>(0.9, 0.25, 0.2)</nameColor>
    <baseInspectLine>Mental state: Nobby nobby rumbling</baseInspectLine>
    <inCaravanCanDo>false</inCaravanCanDo>
  </MentalStateDef>
</Defs>
