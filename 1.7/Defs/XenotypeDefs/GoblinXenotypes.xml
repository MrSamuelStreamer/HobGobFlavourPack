      <li>PsychicAbility_Deaf</li>
      <li>MoveSpeed_VeryQuick</li>
      <li>ToxResist_Partial</li>
      <li>ToxicEnvironmentResistance_Partial</li>
      <li>UVSensitivity_Intense</li>
      <li MayRequire="det.stoneborn">DV_Aggression_Irascible</li>
      <li>MeleeDamage_Weak</li>
      <li>Pain_Reduced</li>
      <li>Sterile</li>
      <li>MSSG_GrotLover</li>
      <li MayRequire="redmattis.bigsmall.core">BS_AlienApperanceStandards</li>
