      <li MayRequire="sarg.alphagenes">AG_Stinky</li>
      <li>PsychicAbility_Deaf</li>
      <li>MoveSpeed_VeryQuick</li>
      <li>ToxResist_Partial</li>
      <li>ToxicEnvironmentResistance_Partial</li>
      <li>UVSensitivity_Intense</li>
      <li>Aggression_Aggressive</li>
      <li>MeleeDamage_Weak</li>
      <li MayRequire="sarg.alphagenes">AG_Rowdy</li>
      <li>Pain_Reduced</li>
      <li>Sterile</li>
      <li MayRequire="vexedtrees980.rimgnoblinsbiotech">RG_GoblinEars</li>
      <li>Beauty_VeryUgly</li>
      <li>BS_AlienApperanceStandards</li>
      <li>Head_Gaunt</li>
      <li>Body_Thin</li>
      <li>Hair_MidBlack</li>
      <li>Hair_DarkBlack</li>
      <li>BS_MossGreenHair</li>
      <li MayRequire="vexedtrees980.rimgnoblinsbiotech">Skin_GoblinDarkGreen</li>
