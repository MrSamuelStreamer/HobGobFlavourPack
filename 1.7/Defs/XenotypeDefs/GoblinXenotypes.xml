      <li>AddictionImmune_Shard</li>
      <li>AddictionResistant_DankPyon_HornetHoney</li>
      <li MayRequire="redmattis.betterprerequisites">BS_FacialAnimDisabled</li>
      <li MayRequire="lazyfridaystudio.genesexpandedblood">GEB_Blood_Guacamole</li>
    </genes>
  </XenotypeDef>
  <!-- Medium Goblin, capable of all work types, human sized, neutral metabolism -->
   <XenotypeDef>
    <defName>MSSG_Goblin</defName>
    <label>Goblin</label>
    <description>Goblins are the larger, smarter, and older Noblins that have somehow survived until adulthood or developing some intelligence - both a rarity in Goblin culture. Goblins manage the Noblins, and day to day life in the Goblin tunnels. It is said that sufficiently venerable Goblins may grow even larger and stronger still.</description>
