<Defs>
  <!-- Small Goblin, only capable of dumb labour, small sized, low metabolism -->
  <XenotypeDef>
    <defName>MSSG_Noblin</defName>
    <label>Noblin</label>
    <description>Noblins are the youngest, weakest, and most numerous caste of goblin society. They are simple creatures often acting as disposable cannon-fodder or forced laborers. Through strange means, a Noblin of sufficient ages and experience can occasionally grow into a much larger, far smarter Goblin.</description>
    <descriptionShort>The smallest and weakest of the goblin races.</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/Custom/Archer_2</iconPath>
    <inheritable>true</inheritable>
    <genes>
      <li MayRequire="sarg.alphagenes">AG_ReducedRaidPresence</li>
      <li MayRequire="sarg.alphagenes">AG_PukeBile</li>
      <li>RobustDigestion</li>
      <li>BS_SlowBleeding</li>
      <li MayRequire="sarg.alphagenes">AG_LimbRegeneration</li>
      <li MayRequire="sarg.alphagenes">AG_HardBones</li>
