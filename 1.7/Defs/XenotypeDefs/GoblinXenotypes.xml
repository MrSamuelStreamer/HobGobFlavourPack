  <!-- Largest Goblin, slow and old, capable of making new hives -->
  <XenotypeDef>
    <defName>MSSG_Hobnobgoblin</defName>
    <label>Queenie Gobber</label>
    <description>Goblin "Queenies" are the oldest and most terrifying of the Goblin castes, almost never seen by anyone outside of Goblin society. It's believed that Hobnobgoblins might be the source of new Goblin hives, but no one is quite sure how the process works.</description>
    <descriptionShort>"Queenies" are the largest and oldest Goblins, capable of forming new Goblin hives.</descriptionShort>
    <iconPath>UI/Icons/Xenotypes/Custom/VBE_CustomXenotypeIcon30</iconPath>
    <inheritable>true</inheritable>
