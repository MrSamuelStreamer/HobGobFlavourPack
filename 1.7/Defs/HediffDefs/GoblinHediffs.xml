<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Visual only: no stages, no comps, no stat effects. Added and kept by HobGob.Gene_GoblinEvolution. -->
  <HediffDef>
    <defName>MSSG_EvolutionProgress</defName>
    <label>goblin growth</label>
    <description>This goblin grows stronger with every kill. The number shows its kills so far against the kills it needs to evolve.</description>
    <hediffClass>HobGob.Hediff_EvolutionProgress</hediffClass>
    <defaultLabelColor>(0.55, 0.85, 0.4)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
  </HediffDef>

  <!-- E1 Pit Overflow: marks a Noblin that just crawled out. Drives MSSG_PitStarving. Lasts 24 hours. -->
  <HediffDef>
    <defName>MSSG_PitFresh</defName>
    <label>pit-fresh</label>
    <description>This noblin crawled out of the spawning pit very recently. It is ravenous and unsettled.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.5, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- E3 Noblin Strike: label only. Removed when the strike ends; Disappears is a backstop for Noblins that leave the map. -->
  <HediffDef>
    <defName>MSSG_OnStrike</defName>
    <label>on strike</label>
    <description>This noblin refuses to work until the colony pays tribute at the spawning pit.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.7, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>210000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <!-- E4 Shiny Fever: the Noblin wants to steal one shiny for the pit. Removed when it hides one; lasts at most a day. -->
  <HediffDef>
    <defName>MSSG_ShinyFever</defName>
    <label>shiny fever</label>
    <description>This noblin has an overwhelming urge to grab something shiny and hide it in the spawning pit.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.95, 0.85, 0.3)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
      <li Class="HobGob.Events.HediffCompProperties_ShinyFever" />
    </comps>
  </HediffDef>

  <!-- Issue #10: a failed goblin install that went in anyway. -->
  <HediffDef>
    <defName>MSSG_BadlyAttached</defName>
    <label>badly attached</label>
    <description>This part was put in by a goblin surgeon. It is on crooked, sewn too tight in places and too loose in others, and only works at half strength.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.8, 0.6, 0.4)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <partEfficiencyOffset>-0.5</partEfficiencyOffset>
      </li>
    </stages>
  </HediffDef>

  <!-- Issue #9: a queen who has just climbed out of a removed spawning pit. -->
  <HediffDef>
    <defName>MSSG_PitTorpor</defName>
    <label>pit torpor</label>
    <description>This queen spent ages curled up at the bottom of a spawning pit. She's dead to the world and needs a good long kip before she's any use.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.6, 0.5, 0.3)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.1</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900000</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
  </HediffDef>

  <!-- Nobby Nobby Rumble: offence only. No armour, dodge or move speed changes on purpose. -->
  <HediffDef>
    <defName>MSSG_RumbleFrenzy</defName>
    <label>rumble frenzy</label>
    <description>This noblin is in the Nobby Nobby Rumble. It hits harder, faster and truer, but it is no tougher and no quicker on its feet.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.25, 0.2)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <statOffsets>
          <MeleeHitChance>8</MeleeHitChance>
        </statOffsets>
        <statFactors>
          <MeleeDamageFactor>2.5</MeleeDamageFactor>
          <MeleeCooldownFactor>0.5</MeleeCooldownFactor>
        </statFactors>
      </li>
    </stages>
    <comps>
      <!-- Backstop for fighters that leave the map mid-rumble; the component removes it normally. -->
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>120000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>
</Defs>
