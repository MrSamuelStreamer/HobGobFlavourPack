<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- E1: active while the pawn has MSSG_PitFresh and food is below 30%. -->
  <ThoughtDef>
    <defName>MSSG_PitStarving</defName>
    <thoughtClass>Thought_Situational</thoughtClass>
    <workerClass>HobGob.Events.ThoughtWorker_PitStarving</workerClass>
    <stages>
      <li>
        <label>fresh from the pit and starving</label>
        <description>I just crawled out of the pit and there's nothing to eat! Where's the food?</description>
        <baseMoodEffect>-12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- E3: the tribute was paid in full. -->
  <ThoughtDef>
    <defName>MSSG_StrikeWon</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>won the strike</label>
        <description>We stopped working and they paid us in shinies! Noblins are clever.</description>
        <baseMoodEffect>5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- E3: the strike timed out unpaid. -->
  <ThoughtDef>
    <defName>MSSG_StrikeBroken</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>strike broken</label>
        <description>Nobody paid us. Back to work for nothing. Not fair.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- E5: after a stampede ends. -->
  <ThoughtDef>
    <defName>MSSG_Winded</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>0.25</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>winded</label>
        <description>All that running. Can't breathe. What were we running from?</description>
        <baseMoodEffect>-3</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- E2: champion won the duel. -->
  <ThoughtDef>
    <defName>MSSG_ChallengeVictor</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>beat the challenger</label>
        <description>I beat that hobgoblin in front of everyone. Who's the big goblin now?</description>
        <baseMoodEffect>8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- E2: other goblins when the champion lost. -->
  <ThoughtDef>
    <defName>MSSG_ChampionShamed</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>our champion lost</label>
        <description>Our champion got flattened by an outsider. Embarrassing.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- E2: the champion who lost. -->
  <ThoughtDef>
    <defName>MSSG_HumiliatedInDuel</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>humiliated in a duel</label>
        <description>I lost the challenge with everyone watching. I'll never live this down.</description>
        <baseMoodEffect>-10</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>MSSG_DuelForbidden</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>forbidden the duel</label>
        <description>We wanted to settle it properly and the chief said no.</description>
        <baseMoodEffect>-6</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <!-- E2: goblins when the challenge was refused or ignored. -->
  <ThoughtDef>
    <defName>MSSG_CowardlyChief</defName>
    <thoughtClass>Thought_Memory</thoughtClass>
    <durationDays>3</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>cowardly chief</label>
        <description>A hobgoblin challenged us and we hid. What kind of goblins are we?</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>
</Defs>
