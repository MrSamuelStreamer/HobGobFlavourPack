<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <GeneDef Name="MSSG_GoblinHiddenGeneBase" Abstract="True">
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>0</biostatCpx>
    <biostatMet>0</biostatMet>
    <canGenerateInGeneSet>false</canGenerateInGeneSet>
    <selectionWeight>0</selectionWeight>
  </GeneDef>

  <!-- Marker gene: the pawn's work priorities are managed automatically and it is hidden from the Work tab. -->
  <GeneDef ParentName="MSSG_GoblinHiddenGeneBase">
    <defName>MSSG_NoblinInstinct</defName>
    <label>noblin instinct</label>
    <description>Carriers of this gene do not take orders about what to work on. They wander from chore to chore, doing whatever dumb labour, mining or plant work seems most urgent.</description>
    <iconPath>UI/Icons/Genes/Gene_NoblinBehaviour</iconPath>
    <!-- Dumb labour only, without disabling joy, beauty or comfort. ManualSkilled is not used: it also covers
         Mining and PlantCutting. Growing and Hunting have no tag of their own; the work component sets them to 0. -->
    <disabledWorkTags>
      <li>Constructing</li>
      <li>Cooking</li>
      <li>Crafting</li>
      <li>Intellectual</li>
      <li>Animals</li>
      <li>Artistic</li>
      <li>Caring</li>
      <li>Social</li>
    </disabledWorkTags>
  </GeneDef>

  <GeneDef ParentName="MSSG_GoblinHiddenGeneBase">
    <defName>MSSG_Evolution_Noblin</defName>
    <label>goblin growth</label>
    <description>Carriers of this gene grow into a Goblin after enough kills.</description>
    <iconPath>UI/Icons/Genes/Gene_Noblin</iconPath>
    <geneClass>HobGob.Gene_GoblinEvolution</geneClass>
    <modExtensions>
      <li Class="HobGob.EvolutionExtension">
        <nextXenotype>MSSG_Goblin</nextXenotype>
        <totalKillsRequired>10</totalKillsRequired>
        <rareXenotype>MSSG_Snoblin</rareXenotype>
        <rareChance>0.05</rareChance>
        <seasonalKills>true</seasonalKills>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="MSSG_GoblinHiddenGeneBase">
    <defName>MSSG_Evolution_Goblin</defName>
    <label>hobgoblin growth</label>
    <description>Carriers of this gene grow into a Hobgoblin after enough kills.</description>
    <iconPath>UI/Icons/Genes/Gene_Goblin</iconPath>
    <geneClass>HobGob.Gene_GoblinEvolution</geneClass>
    <modExtensions>
      <li Class="HobGob.EvolutionExtension">
        <nextXenotype>MSSG_Hobgoblin</nextXenotype>
        <totalKillsRequired>50</totalKillsRequired>
        <minVictimBodySize>0.6</minVictimBodySize>
        <seasonalKills>true</seasonalKills>
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="MSSG_GoblinHiddenGeneBase">
    <defName>MSSG_Evolution_HobGoblin</defName>
    <label>queenie growth</label>
    <description>Carriers of this gene can grow into a Queenie after enough kills, when you choose. Each kill after that has a small chance of turning them into a Queenie at once, or of killing them and spilling out a handful of noblins.</description>
    <iconPath>UI/Icons/Genes/Gene_Hobgoblin</iconPath>
    <geneClass>HobGob.Gene_GoblinEvolution</geneClass>
    <modExtensions>
      <li Class="HobGob.EvolutionExtension">
        <nextXenotype>MSSG_Hobnobgoblin</nextXenotype>
        <totalKillsRequired>75</totalKillsRequired>
        <minVictimBodySize>0.6</minVictimBodySize>
        <seasonalKills>true</seasonalKills>
        <manualEvolution>true</manualEvolution>
        <!-- <gizmoIconPath>UI/Abilities/EvolveQueen</gizmoIconPath> -->
      </li>
    </modExtensions>
  </GeneDef>

  <GeneDef ParentName="MSSG_GoblinHiddenGeneBase">
    <defName>MSSG_Evolution_Hobnobgoblin</defName>
    <label>Queenie Gobber instinct</label>
    <description>Carriers of this gene have the inate instinct to entomb themselves in a goblin spawning pit, forever creating more Noblins for the nest.</description>
    <iconPath>UI/Icons/Genes/Gene_Hobnobgoblin</iconPath>
    <abilities>
			<li>MSSG_DigHole</li>
		</abilities>
    <geneClass>HobGob.Gene_GoblinEvolution</geneClass>
  </GeneDef>

  <GeneDef ParentName="MSSG_GoblinHiddenGeneBase">
    <defName>MSSG_Evolution_Snoblin</defName>
    <label>Snoblin Aura</label>
    <description>Carriers of this gene have the inate instinct to entomb themselves in a goblin spawning pit, forever creating more Noblins for the nest.</description>
    <iconPath>UI/Icons/Genes/Gene_Snoblin</iconPath>
    <geneClass>HobGob.Gene_GoblinEvolution</geneClass>
  </GeneDef>

  <!-- Grot lover: beauty flips, filth helps a goblin surgeon and a goblin patient, sterile rooms upset them.
       Effects live in HobGob.HarmonyPatches.GrotLoverPatches and HobGob.Grot.ThoughtWorker_GrotRoom. -->
  <GeneDef>
    <defName>MSSG_GrotLover</defName>
    <label>grot lover</label>
    <description>Carriers of this gene love muck. Filth and ugly things look lovely to them, and pretty things look awful.\n\nA grot-loving surgeon works better in a filthy room and worse in a sterile one. A grot-loving patient tended in a filthy room is less likely to get an infection, and more likely in a sterile one.\n\nThey are unhappy when their bed is in a sterile room and happy when it is properly grotty.</description>
    <iconPath>UI/Icons/Genes/Gene_PooPooSniffer</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
  </GeneDef>

  <!-- Fings is fings: +6 Crafting aptitude, but everything the carrier makes comes out Normal quality.
       The quality cap lives in HobGob.HarmonyPatches.FingsIsFingsPatches. -->
  <GeneDef>
    <defName>MSSG_FingsIsFings</defName>
    <label>fings is fings</label>
    <description>Carriers of this gene do not see why a stabber needs to be pretty. It stabs. Everything they make is normal quality.\n\nTheir makin' aptitude is increased by 6. The quality limit covers everything they make: gear, furniture, buildings and art.</description>
    <iconPath>UI/Icons/Genes/Gene_SnoblinCraft</iconPath>
    <displayCategory>Miscellaneous</displayCategory>
    <aptitudes>
      <Crafting>6</Crafting>
    </aptitudes>
    <biostatCpx>1</biostatCpx>
    <biostatMet>0</biostatMet>
  </GeneDef>
</Defs>
