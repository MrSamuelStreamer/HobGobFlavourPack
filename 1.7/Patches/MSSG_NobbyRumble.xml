<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Nobby Nobby Rumble: fighters attack other fighters, downed ones included. Wander if nobody is in reach. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThinkTreeDef[defName="MentalStateCritical"]/thinkRoot/subNodes</xpath>
    <order>Prepend</order>
    <value>
      <li Class="ThinkNode_ConditionalMentalState">
        <state>MSSG_NobbyRumble</state>
        <subNodes>
          <li Class="ThinkNode_Priority">
            <subNodes>
              <li Class="HobGob.Rumble.JobGiver_NobbyRumble" />
              <li Class="JobGiver_WanderAnywhere">
                <maxDanger>Deadly</maxDanger>
              </li>
            </subNodes>
          </li>
        </subNodes>
      </li>
    </value>
  </Operation>

  <!-- Backup for fighters a mod keeps out of the mental state: same jobs, first in the Humanlike tree. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThinkTreeDef[defName="Humanlike"]/thinkRoot/subNodes</xpath>
    <order>Prepend</order>
    <value>
      <li Class="HobGob.Rumble.ThinkNode_ConditionalRumbleFighter">
        <subNodes>
          <li Class="ThinkNode_Priority">
            <subNodes>
              <li Class="HobGob.Rumble.JobGiver_NobbyRumble" />
              <li Class="JobGiver_WanderAnywhere">
                <maxDanger>Deadly</maxDanger>
              </li>
            </subNodes>
          </li>
        </subNodes>
      </li>
    </value>
  </Operation>
</Patch>
