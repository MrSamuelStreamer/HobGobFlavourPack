<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Death duel: melee the named partner, downed ones included. Mirrors the goblin duel think node. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThinkTreeDef[defName="MentalStateCritical"]/thinkRoot/subNodes</xpath>
    <order>Prepend</order>
    <value>
      <li Class="ThinkNode_ConditionalMentalState">
        <state>MSSG_GoblinDeathDuel</state>
        <subNodes>
          <li Class="ThinkNode_Priority">
            <subNodes>
              <li Class="HobGob.Events.JobGiver_GoblinDeathDuel" />
              <li Class="JobGiver_WanderAnywhere">
                <maxDanger>Deadly</maxDanger>
              </li>
            </subNodes>
          </li>
        </subNodes>
      </li>
    </value>
  </Operation>
</Patch>
