<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Knob Gob Gobbo Gone Wild: brawlers throw social-fight blows at the other side. Wander if nobody is in reach. -->
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThinkTreeDef[defName="MentalStateCritical"]/thinkRoot/subNodes</xpath>
    <order>Prepend</order>
    <value>
      <li Class="ThinkNode_ConditionalMentalState">
        <state>MSSG_GobBrawl</state>
        <subNodes>
          <li Class="ThinkNode_Priority">
            <subNodes>
              <li Class="HobGob.Events.JobGiver_GobBrawl" />
              <li Class="JobGiver_WanderAnywhere">
                <maxDanger>Deadly</maxDanger>
              </li>
            </subNodes>
          </li>
        </subNodes>
      </li>
    </value>
  </Operation>
</Patch>
